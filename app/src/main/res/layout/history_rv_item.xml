<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="103dp"
    android:layout_marginHorizontal="20dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="15dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/historyFoodImage"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginStart="16dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/placeholderimage" />

        <TextView
            android:id="@+id/historyFoodname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-condensed-medium"
            android:text="food"
            android:textSize="15sp"
            app:layout_constraintBottom_toTopOf="@+id/historyRestaurant"
            app:layout_constraintStart_toEndOf="@+id/historyFoodImage"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/historyRestaurant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-condensed-medium"
            android:text="restaurant"
            android:textSize="15sp"
            app:layout_constraintBottom_toTopOf="@+id/historyPrice"
            app:layout_constraintStart_toEndOf="@+id/historyFoodImage"
            app:layout_constraintTop_toBottomOf="@+id/historyFoodname" />

        <TextView
            android:id="@+id/historyPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-condensed-medium"
            android:text="price"
            android:textColor="#15BE77"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/historyFoodImage"
            app:layout_constraintTop_toBottomOf="@+id/historyRestaurant" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buyAgain"
            android:layout_width="85dp"
            android:layout_height="30dp"
            android:layout_marginEnd="45dp"
            android:background="@drawable/start_activity_button"
            android:fontFamily="sans-serif-condensed-medium"
            android:text="Buy Again"
            android:textColor="#FFFFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>