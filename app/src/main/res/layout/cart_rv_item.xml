<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="87dp"
    android:layout_marginHorizontal="20dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="15dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imageView7"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="15dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:srcCompat="@tools:sample/avatars" />

        <TextView
            android:id="@+id/foodInCartName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-condensed-medium"
            android:text="foodName"
            android:textSize="15sp"
            app:layout_constraintBottom_toTopOf="@+id/priceInCart"
            app:layout_constraintStart_toEndOf="@+id/imageView7"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/priceInCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-condensed-medium"
            android:text="price"
            android:textColor="#15BE77"
            android:textSize="22sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/imageView7"
            app:layout_constraintTop_toBottomOf="@+id/foodInCartName" />

        <ImageButton
            android:id="@+id/cartPlus"
            android:layout_width="26dp"
            android:layout_height="26dp"
            app:layout_constraintBottom_toBottomOf="@+id/itemQuantity"
            app:layout_constraintEnd_toStartOf="@+id/itemQuantity"
            app:layout_constraintTop_toTopOf="@+id/itemQuantity"
            app:srcCompat="@drawable/icon_plus" />

        <ImageButton
            android:id="@+id/cartMinus"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/icon_minus" />

        <TextView
            android:id="@+id/itemQuantity"
            android:layout_width="40dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="Qt"
            app:layout_constraintBottom_toBottomOf="@+id/cartMinus"
            app:layout_constraintEnd_toStartOf="@+id/cartMinus"
            app:layout_constraintTop_toTopOf="@+id/cartMinus" />

        <ImageButton
            android:id="@+id/cartDelete"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginTop="15dp"
            android:background="@null"
            app:layout_constraintEnd_toEndOf="@+id/cartMinus"
            app:layout_constraintStart_toStartOf="@+id/cartPlus"
            app:layout_constraintTop_toBottomOf="@+id/itemQuantity"
            app:srcCompat="@drawable/trash_03" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>